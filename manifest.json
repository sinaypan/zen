{
  "manifest_version": 3,
  "name": "Zen",
  "version": "0.2.0",
  "description": "Une baguette pour masquer ce qui gêne sur un site, et le garder masqué à chaque visite.",
  "permissions": ["storage", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["apply.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zen",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "wand": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Prendre la baguette sur la page affichée"
    }
  }
}
